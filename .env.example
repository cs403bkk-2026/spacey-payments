# Copy to .env for local use. Never commit .env or real credentials.
DATABASE_URL=postgresql://spacey:spacey@localhost:5433/spacey
APP_REVISION=local
LOG_LEVEL=INFO
# Shared secret Purchase sends as X-Service-Token. Unset = every payment endpoint answers 401.
SERVICE_TOKEN=local-dev-token
# Truncates the payments table on start. Disposable local/test data only.
RESET_DB_ON_START=false
